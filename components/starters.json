  {
    "name": "chart",
    "title": "Chart",
    "description": "Line, area, bar, horizontal bar or donut chart with a headline number and change; tap or drag to read values, and a Show data view. Set headline.good to \"down\" when lower is better (weight, spending). Use for any numbers over time or across categories: spending, weight, steps, prices, scores.",
    "example": {
      "type": "line",
      "title": "Weight",
      "subtitle": "Last 8 weeks",
      "unit": " kg",
      "unit_after": true,
      "headline": {
        "value": "78.4 kg",
        "change": "-2.1 kg",
        "good": "down"
