# Copy to .env (never commit it). Every value is optional.

# What this hub is called in the app.
HEARTH_NAME=Home

# Where your data lives. Plain JSON files you own; back this folder up.
HEARTH_DATA=./data

# Database. Default is SQLite in HEARTH_DATA. Point it at your own if you prefer:
#   HEARTH_DB_URL=postgres://user:pass@host:5432/hearth
#   HEARTH_DB_URL=mysql://user:pass@host:3306/hearth
#   HEARTH_DB_URL=mongodb://host:27017/hearth   (run `bun add mongodb` first)
HEARTH_DB_URL=

# Bind address. Keep 127.0.0.1 and put Caddy (deploy/Caddyfile) in front for HTTPS.
HEARTH_HOST=127.0.0.1
HEARTH_PORT=8790

# The brain: claude | codex | echo (offline demo brain) | custom
HEARTH_AGENT=claude
# For HEARTH_AGENT=custom: a JSON array. The prompt is sent on stdin, the reply read from stdout.
# HEARTH_AGENT_CMD=["ollama","run","llama3.1"]
HEARTH_AGENT_TIMEOUT_SEC=180

# Other hubs' web origins allowed to call this hub from the same phone app.
# Comma separated, e.g. https://laptop.example.com
HEARTH_ALLOWED_ORIGINS=

# Contact for Web Push (Apple and Google require a mailto: or https: URL).
HEARTH_CONTACT=mailto:you@example.com

# Set to 1 when HTTPS is in front of the hub (adds HSTS, trusts X-Forwarded-For for rate limits).
HEARTH_BEHIND_PROXY=0

# The address your phone uses (printed in pairing links).
HEARTH_PUBLIC_URL=
