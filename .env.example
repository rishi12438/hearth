# Copy to .env (never commit it). Every value is optional.

# What this hub is called in the app.
HEARTH_NAME=Hearth

# Where your data lives. Plain JSON files you own; back this folder up.
HEARTH_DATA=./data

# Database. Default is SQLite in HEARTH_DATA. Point it at your own if you prefer:
#   HEARTH_DB_URL=postgres://user:pass@host:5432/hearth
#   HEARTH_DB_URL=mysql://user:pass@host:3306/hearth
#   HEARTH_DB_URL=mongodb://host:27017/hearth   (run `bun add mongodb` first)
HEARTH_DB_URL=

# Bind address. Keep 127.0.0.1 and put Caddy (deploy/Caddyfile) in front for HTTPS.
HEARTH_HOST=127.0.0.1
HEARTH_PORT=8790

# The brain: claude | codex | echo (offline demo brain) | custom
HEARTH_AGENT=claude
# For HEARTH_AGENT=custom: a JSON array. The prompt is sent on stdin, the reply read from stdout.
# HEARTH_AGENT_CMD=["ollama","run","llama3.1"]
HEARTH_AGENT_TIMEOUT_SEC=180

# Three roles, each a harness + model. The app can change these later (Menu → Brains).
# Orchestrator splits rambles into jobs; workhorse does light jobs; heavy does hard ones and escalations.
# HEARTH_ORCHESTRATOR_AGENT=claude
# HEARTH_QUICK_MODEL=claude-haiku-5-5          # simple jobs: reminders, notes, pinning
# HEARTH_ORCHESTRATOR_MODEL=claude-opus-5-5     # plans every message: who does what, on which model
# HEARTH_WORKHORSE_AGENT=claude
# HEARTH_WORKHORSE_MODEL=claude-sonnet-5-5
# HEARTH_HEAVY_AGENT=codex
# HEARTH_HEAVY_MODEL=

# Other hubs' web origins allowed to call this hub from the same phone app.
# Comma separated, e.g. https://laptop.example.com
HEARTH_ALLOWED_ORIGINS=

# Face ID lock. 1 = every device must unlock with a passkey (Face ID, Touch ID, Windows Hello) before it sees anything,
# so a copied device key alone is useless. Each device can also turn it on for itself under Settings.
HEARTH_REQUIRE_PASSKEY=0
# How long one unlock lasts on a device (closing the app also locks it).
# HEARTH_UNLOCK_HOURS=12

# Contact for Web Push (Apple and Google require a mailto: or https: URL).
HEARTH_CONTACT=mailto:you@example.com

# Set to 1 when HTTPS is in front of the hub (adds HSTS, trusts X-Forwarded-For for rate limits).
HEARTH_BEHIND_PROXY=0

# The address your phone uses (printed in pairing links).
HEARTH_PUBLIC_URL=

# Voice: hold-to-talk in the app uploads audio to the hub, which transcribes it. The key never reaches the phone.
# HEARTH_STT=deepgram
HEARTH_DEEPGRAM_API_KEY=

# Library search: embeddings shortlist skills/workflows/scripts before anyone builds something new.
# Without a key it falls back to keyword matching (works fine for small libraries).
# HEARTH_EMBEDDINGS=fireworks
HEARTH_FIREWORKS_API_KEY=

# Parallel jobs: overall cap, plus optional per-harness caps.
HEARTH_MAX_PARALLEL=4
# HEARTH_MAX_PARALLEL_CLAUDE=3
# HEARTH_MAX_PARALLEL_CODEX=2
# Spending caps in USD (harnesses that report cost). Over the cap, jobs park and tell you instead of running.
HEARTH_COST_CAP_RAMBLE_USD=2
HEARTH_COST_CAP_DAY_USD=10
# Nightly cleanup removes skills/workflows unused this many days (pinned ones stay).
HEARTH_PURGE_UNUSED_DAYS=45
