# systemd unit for the hub. deploy/setup-lightsail.sh installs it, and deploy/update.sh re-installs it on every
# deploy when it changed, so an edit here reaches the live hub without a manual step.
[Unit]
Description=Hearth personal assistant hub
After=network-online.target
Wants=network-online.target

[Service]
User=hearth
WorkingDirectory=/opt/hearth
EnvironmentFile=/opt/hearth/.env
ExecStart=/home/hearth/.bun/bin/bun src/cli.ts start
# Claude Code (native install) lives in ~/.local/bin, Codex (npm) in /usr/local/bin.
Environment=PATH=/home/hearth/.local/bin:/home/hearth/.bun/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=3
# Hardening: the hub only needs its own folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# ~/.enkidu: before a job browses, the hub writes your connected logins to ~/.enkidu/chrome-logins.json, which the
# job's Chrome opens with (src/brains/browser-logins.ts). Read-only, every job's browser opens signed out of everything.
ReadWritePaths=/opt/hearth/data /home/hearth/.claude /home/hearth/.codex -/home/hearth/.enkidu -/home/hearth/.claude.json -/home/hearth/.local/share/claude -/home/hearth/.local/state/claude
# No ProtectKernelTunables: it stops the brain's jail (bubblewrap, src/brains/jail.ts) from giving each run its own /proc,
# which is what hides this hub's environment (API keys) from code the brain runs. The hub isn't root, so it can't change
# kernel settings anyway.
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
