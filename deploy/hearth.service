# systemd unit for the hub. Install:
#   sudo cp deploy/hearth.service /etc/systemd/system/ && sudo systemctl enable --now hearth
[Unit]
Description=Hearth personal assistant hub
After=network-online.target
Wants=network-online.target

[Service]
User=hearth
WorkingDirectory=/opt/hearth
EnvironmentFile=/opt/hearth/.env
ExecStart=/home/hearth/.bun/bin/bun src/cli.ts start
Restart=always
RestartSec=3
# Hardening: the hub only needs its own folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/hearth/data /home/hearth/.claude /home/hearth/.codex
# The workbench: the hub starts its Docker container through the socket.
ReadWritePaths=-/run/docker.sock
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
